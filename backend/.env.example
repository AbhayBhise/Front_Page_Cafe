# ---- Front Page Cafe API — environment ----
NODE_ENV=production
PORT=5000

# Comma-separated list of allowed browser origins (your deployed frontend URL).
CLIENT_ORIGIN=https://app.example.com
# Public URL of the customer web app — used to build table QR deep links.
PUBLIC_WEB_URL=https://app.example.com

# PostgreSQL connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/frontpagecafe

# Auth secrets — generate unique values, e.g.  openssl rand -base64 48
# The server refuses to boot in production with the dev placeholders.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
GUEST_TOKEN_TTL=4h

# Bootstrap platform admin (created on first boot if no admin exists).
# If ADMIN_PASSWORD is omitted a random one is generated and logged once.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=Platform Admin

PAYMENTS_MODE=simulated
