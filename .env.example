# ---- docker-compose deployment settings ----
# Copy to `.env` (same folder as docker-compose.yml) and fill in.

# Public URL the app is served from (used for CORS + table QR links).
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080

# Postgres password for the bundled db service.
DB_PASSWORD=change_me_strong_password

# Auth secrets — REQUIRED. Generate with:  openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# First-boot platform admin. Leave ADMIN_PASSWORD empty to auto-generate
# (it is printed once in the api container logs).
ADMIN_EMAIL=admin@frontpagecafe.com
ADMIN_PASSWORD=
